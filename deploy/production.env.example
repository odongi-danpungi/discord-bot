# Production host bootstrap example. Copy required values into your host's secret/env settings.
APP_PROFILE=production
HOST=0.0.0.0
PORT=3000
# Public HTTPS origin ending with /. Do not include credentials/query/fragment.
PUBLIC_BASE_URL=https://bot.example.com/
# Exact reverse-proxy hop count. For one trusted edge proxy, use 1.
TRUST_PROXY_HOPS=1
# Viewer self-service URL should stay on HTTPS.
VIEWER_URL=https://bot.example.com/viewer/
# Required core values: put real values in the host Secret Manager, not in this file/repository.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DASHBOARD_USER=
DASHBOARD_PASSWORD=
BROADCAST_TOKEN=

# Optional delegated mobile operator. Set both or neither.
DASHBOARD_OPERATOR_USER=
DASHBOARD_OPERATOR_PASSWORD=
DASHBOARD_OPERATOR_CAPABILITIES=live,queue,broadcast,discord

# Naver Cafe integration (required for Naver posting/comment features).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://bot.example.com/naver/callback
NAVER_CAFE_ID=
NAVER_MENU_ID=
NAVER_MEMO_MENU_ID=
NAVER_TOKEN_KEY=

# CHZZK live monitor.
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
CHZZK_CHANNEL_ID=
CHZZK_MONITOR_ENABLED=true

# Optional CHZZK follower verification. Register PUBLIC_BASE_URL origin + /oauth/chzzk/callback.
# Keep disabled until CHZZK scopes, a permission-free Discord role and a separate 32-byte key are ready.
CHZZK_VERIFY_ENABLED=false
# 선택 사항: 비우면 서버별 인증 역할을 자동 생성·저장합니다. 기존 기본 서버 역할만 지정 가능.
CHZZK_VERIFY_ROLE_ID=
CHZZK_VERIFY_NICKNAME_SYNC=false
CHZZK_TOKEN_KEY=
# Defaults beside DATA_FILE; the default Railway /app/data volume preserves this file.
# CHZZK_VERIFICATION_FILE=/app/data/chzzk-verification.json

# Run `npm run env:check` before `npm start`. The command reports only safe status text, never secret values.
