DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_id
DISCORD_GUILD_ID=your_server_id
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=choose_a_unique_password_at_least_12_characters
BROADCAST_TOKEN=
ADMIN_ROLE_ID=
HOST=127.0.0.1
PORT=3000
VIEWER_URL=
DATA_FILE=./data/registrations.json
OPERATIONS_FILE=./data/operations.json

# Optional separate recovery/audit store
RECOVERY_FILE=./data/recovery.json

# Optional crash-safe multi-file restore transaction journal
RESTORE_TRANSACTION_FILE=./data/restore-transaction.json

# Optional Discord policy baseline / change journal store
DISCORD_POLICY_FILE=./data/discord-policy.json

# Runtime profile: production or development (DEMO.cmd uses an isolated demo profile)
APP_PROFILE=production

# Deployment backup retention
BACKUP_DIR=./data/backups
BACKUP_KEEP_COUNT=14
BACKUP_MAX_AGE_DAYS=30
BACKUP_INTERVAL_HOURS=24

# Recovery continuity objectives and automatic non-destructive drill cadence
RECOVERY_RPO_HOURS=24
RECOVERY_DRILL_AUTO=true
RECOVERY_DRILL_INTERVAL_DAYS=7
RECOVERY_DRILL_RETRY_HOURS=6

# Optional incident workflow queue/timeline store
INCIDENT_WORKFLOW_FILE=./data/incidents.json
