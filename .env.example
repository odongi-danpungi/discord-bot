DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_id
DISCORD_GUILD_ID=your_server_id
DASHBOARD_USER=admin
# Production: use a unique 16+ character value when possible. Never reuse this for other secrets.
DASHBOARD_PASSWORD=choose_a_unique_password_at_least_12_characters
# Optional delegated operator account for Mobile Live Control only.
# Capabilities: live,queue,broadcast,discord (comma-separated).
DASHBOARD_OPERATOR_USER=
DASHBOARD_OPERATOR_PASSWORD=
DASHBOARD_OPERATOR_CAPABILITIES=live,queue,broadcast,discord
# Required for external HOST binding. Use a unique random value of at least 24 characters.
BROADCAST_TOKEN=
ADMIN_ROLE_ID=
HOST=127.0.0.1
PORT=3000
# Public production HTTPS origin, e.g. https://bot.example.com/
PUBLIC_BASE_URL=
# Exact number of trusted reverse-proxy hops. Keep 0 when no trusted proxy is in front.
TRUST_PROXY_HOPS=0
VIEWER_URL=
DATA_FILE=./data/registrations.json
OPERATIONS_FILE=./data/operations.json

# Optional separate recovery/audit store
RECOVERY_FILE=./data/recovery.json

# Optional Discord policy baseline / change journal store
DISCORD_POLICY_FILE=./data/discord-policy.json

# Runtime profile: production or development (DEMO.cmd uses an isolated demo profile)
APP_PROFILE=production

# Deployment backup retention
BACKUP_DIR=./data/backups
BACKUP_KEEP_COUNT=14
BACKUP_MAX_AGE_DAYS=30
BACKUP_INTERVAL_HOURS=24

# Optional incident workflow queue/timeline store
INCIDENT_WORKFLOW_FILE=./data/incidents.json

# Persistent admin idempotency journal for crash-safe duplicate request blocking
IDEMPOTENCY_FILE=./data/idempotency.json

# Optional Naver Cafe integration (official NAVER Open API only)
# Register the same callback URL in NAVER Developers. For local testing:
# NAVER_REDIRECT_URI=http://127.0.0.1:3000/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
NAVER_CAFE_ID=
NAVER_MENU_ID=
# Optional dedicated menu id for the "메모" board used by 칼바람 시참. Falls back to NAVER_MENU_ID when empty.
NAVER_MEMO_MENU_ID=
# 32-byte encryption key for OAuth tokens. Keep this secret; do not commit a real key.
# Example generation on your own PC: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NAVER_TOKEN_KEY=
NAVER_AUTH_FILE=./data/naver-auth.json

# Optional Naver public Cafe article monitor (official Search API polling only)
# The Search API requires a query. The target Cafe URL filter is strongly recommended.
NAVER_MONITOR_ENABLED=false
NAVER_MONITOR_QUERY=
NAVER_MONITOR_CAFE_URL=
NAVER_MONITOR_INTERVAL_MINUTES=5
NAVER_MONITOR_DISCORD_ALERTS=true
NAVER_MONITOR_FILE=./data/naver-monitor.json

# Local queue/order state for 칼바람 시참 memo sessions
NAVER_PARTICIPATION_FILE=./data/naver-participation.json

# Canonical broadcast participation queue shared by Discord / Naver / dashboard
PARTICIPATION_QUEUE_FILE=./data/participation-queue.json

# Broadcast operations hub: schedules, polls, game presets, timeline, notification center
BROADCAST_OPS_FILE=./data/broadcast-ops.json

# Broadcast participation call response window (15-300 seconds)
PARTICIPATION_CALL_TIMEOUT_SECONDS=60

# Optional CHZZK official Open API live start/end monitor
# Register an application at CHZZK Developers and use Client authentication.
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
# 32-character CHZZK channel id, e.g. abcdef0123456789abcdef0123456789
CHZZK_CHANNEL_ID=
CHZZK_MONITOR_ENABLED=false
# 1, 2, 5, 10, or 15 minutes
CHZZK_MONITOR_INTERVAL_MINUTES=2
CHZZK_MONITOR_DISCORD_ALERTS=true
# Official /open/v1/lives returns max 20 items per page. If this cap is reached,
# the monitor reports UNKNOWN instead of falsely declaring the stream offline.
CHZZK_LIVE_SCAN_MAX_PAGES=50
CHZZK_LIVE_FILE=./data/chzzk-live.json

# Read-only production probes: 0 disables automatic probing; 60..3600 enables it.
PRODUCTION_MONITOR_INTERVAL_SECONDS=0
# CHZZK 팔로워 인증 (기본 OFF). 비밀값은 Railway Variables에 직접 설정하세요.
# 공개 HTTPS PUBLIC_BASE_URL 및 기존 CHZZK_CLIENT_ID / SECRET / CHANNEL_ID 필요
CHZZK_VERIFY_ENABLED=false
CHZZK_VERIFY_ROLE_ID=
CHZZK_VERIFY_NICKNAME_SYNC=true
# 32바이트 무작위 키: 64자리 HEX 또는 Base64. 재배포 후에도 같은 키 유지.
CHZZK_TOKEN_KEY=
# DATA_FILE의 디렉터리 아래에 자동 생성. Railway persistent volume 안에 보관.
# CHZZK_VERIFICATION_FILE=/app/data/chzzk-verification.json
